# LiteLLM 代理配置
ANTHROPIC_AUTH_TOKEN=sk-litellm-master-key-2026
ANTHROPIC_BASE_URL=http://223.85.234.67:4000/v1/
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-20250514
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-sonnet-4-20250514
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-sonnet-4-20250514
API_TIMEOUT_MS=3000000

# 通用设置
CC_HAHA_DISCONNECT_GRACE_MS=300000
CC_HAHA_PREWARM_IDLE_TIMEOUT_MS=1800000
CC_HAHA_HTTP_IDLE_TIMEOUT=255
DISABLE_TELEMETRY=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# 上下文管理 - 防止上下文爆满导致断开
# 256k上下文的80% = 204800，CLI在达到此阈值时自动压缩
CLAUDE_CODE_AUTO_COMPACT_WINDOW=204800
# 模型上下文窗口配置（JSON格式，覆盖默认值）
CLAUDE_CODE_MODEL_CONTEXT_WINDOWS={"claude-sonnet-4-20250514":256000,"claude-sonnet-4":256000}
